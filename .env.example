# ───────────────────────────────────────────────────────────────────────────
# Paliwal Secure — Environment Variables Template
# ───────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# NEVER commit the real `.env` file. It is in .gitignore.
#
# In PRODUCTION: set these in your hosting provider's dashboard (Vercel,
# Railway, Render, etc.). If JWT_SECRET / JWT_REFRESH_SECRET are missing in
# production, the app will HARD-FAIL on startup (intentional — fail closed).
# ───────────────────────────────────────────────────────────────────────────

# ── Database ───────────────────────────────────────────────────────────────
# SQLite (dev):
DATABASE_URL="file:./db/custom.db"
# Postgres / Neon (prod recommended):
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ── JWT Secrets (REQUIRED in production) ───────────────────────────────────
# Generate with:  openssl rand -base64 48
JWT_SECRET="change-me-to-a-64-char-random-string"
JWT_REFRESH_SECRET="change-me-to-a-different-64-char-random-string"

# ── Admin Bootstrap (optional, but recommended for first deploy) ───────────
# If the DB has no admin users, the /admin/setup page will use these to seed
# the first admin. Leave blank to use the interactive setup flow.
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""   # bcrypt hash — generate with: node -e "console.log(require('bcryptjs').hashSync('YourPassword',12))"
ADMIN_TOTP_SECRET=""      # base32 TOTP secret — generate with: node -e "console.log(require('speakeasy').generateSecret().base32)"

# ── Admin Hardening (recommended) ──────────────────────────────────────────
# Comma-separated list of allowed admin IPs (leave blank to allow all):
ADMIN_ALLOWED_IPS=""
# Invite code required to access /admin/setup (leave blank to disable invite):
ADMIN_SETUP_INVITE_CODE=""

# ── Cron Jobs (REQUIRED in production if using Vercel Cron) ────────────────
# Generate with:  openssl rand -hex 32
# Used by /api/cron/* routes — must be sent as `Authorization: Bearer <secret>`
CRON_SECRET="change-me-to-a-64-char-hex-string"

# ── AI / LLM ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
# z-ai-web-dev-sdk uses ZAI_API_KEY under the hood — set in hosting dashboard
ZAI_API_KEY=""

# ── WhatsApp Business API ──────────────────────────────────────────────────
WHATSAPP_TOKEN=""              # Cloud API access token
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""       # Webhook verification token (REQUIRED in prod — no fallback)
WHATSAPP_BUSINESS_PHONE_ID=""

# Public-facing WhatsApp number (safe to expose to client)
NEXT_PUBLIC_WHATSAPP_NUMBER="919257877312"

# ── Site URL (for canonical, OG, sitemap) ──────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://paliwalsecure.in"

# ── Optional integrations ──────────────────────────────────────────────────
# Neon Postgres (for trends/auto-publish):
NEON_DATABASE_URL=""
# Cloudflare Turnstile (anti-spam for public forms):
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
